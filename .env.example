NODE_ENV=production
HOST=127.0.0.1
PORT=6943
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret
# Create a password hash with: npm run hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
# Optional: set to 1 only when correctly behind a trusted HTTPS reverse proxy
TRUST_PROXY=0
# Remote desktop / VM console launch URL (Guacamole or noVNC over HTTPS; protect it separately)
VM_CONSOLE_URL=
